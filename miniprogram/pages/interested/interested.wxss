/* pages/interested/interested.wxss */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 页面标题 */
.page-header {
  padding: 20rpx 0;
  text-align: center;
  background-color: #fff;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 项目列表 */
.project-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.project-item {
  position: relative;
  background-color: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

/* 状态标签 */
.status-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 10rpx 20rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 0 10rpx 0 10rpx;
  z-index: 10;
}

/* 项目卡片 */
.project-card {
  padding: 30rpx;
  padding-top: 50rpx; /* 为状态标签留出空间 */
}

/* 项目标题区域 */
.project-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.project-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 20rpx;
}

.school-name {
  font-size: 24rpx;
  color: #666;
  background-color: #f0f0f0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

/* 项目信息 */
.project-info {
  margin-bottom: 20rpx;
}

.project-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 项目详情 */
.project-details {
  margin-bottom: 30rpx;
}

.detail-row {
  display: flex;
  margin-bottom: 15rpx;
}

.detail-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  align-items: center;
  margin-bottom: 20rpx;
}

.btn {
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  outline: none;
}

.btn-primary {
  background-color: #1890ff;
  color: #fff;
}

.btn-primary:active {
  background-color: #096dd9;
}

.btn-success {
  background-color: #52c41a;
  color: #fff;
}

.btn-success:active {
  background-color: #389e0d;
}

.btn-danger {
  background-color: #ff4d4f;
  color: #fff;
}

.btn-danger:active {
  background-color: #d9363e;
}

.rejected-tip {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background-color: #fff2f0;
  border-radius: 8rpx;
  border: 1rpx solid #ffccc7;
}

.rejected-tip text {
  color: #ff4d4f;
  font-size: 26rpx;
}

/* 时间信息 */
.time-info {
  display: flex;
  justify-content: space-between;
  border-top: 1rpx solid #f0f0f0;
  padding-top: 20rpx;
}

.time-text {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 加载更多提示 */
.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.load-more-text {
  font-size: 26rpx;
  color: #999;
}

/* 响应式适配 */
@media screen and (max-width: 375px) {
  .project-name {
    font-size: 30rpx;
  }
  
  .detail-value {
    font-size: 24rpx;
  }
  
  .btn {
    padding: 12rpx 24rpx;
    font-size: 26rpx;
  }
}