<!-- pages/interested/interested.wxml -->
<view class="content">
  <block wx:for="{{projectList}}" wx:key="id" wx:for-index="index" wx:for-item="project">
    <view class="body {{project.status === 'accept' ? 'accept' : 'refuse'}}">
      <view class="body-header">
        {{project.status === 'accept' ? '祝贺您，项目小队向您发出进一步了解的请求' : '已投递，暂无反馈'}}
      </view>
      <view class="body-main">
        <view>
          <text>项目简要信息</text>
          <text>{{project.schoolName || ''}}</text>
        </view>
        
        <view>
          <text>{{project.description || ''}}</text>
        </view>
        
        <view>
          <view>
            <text>学校要求</text>
            <text>{{project.educationRequirement || ''}}</text>
          </view>
          <view>
            <text>技能要求</text>
            <text>{{project.skillRequirement || ''}}</text>
          </view>
        </view>
        
        <view>
          <button 
            bindtap="deleteProject" 
            data-id="{{project.id}}" 
            data-index="{{index}}">
            删除
          </button>
          <button 
            bindtap="nextStep" 
            data-id="{{project.id}}" 
            data-status="{{project.status}}">
            下一步
          </button>
        </view>
      </view>
    </view>
  </block>
  
  <!-- 空状态提示 -->
  <view wx:if="{{projectList.length === 0}}" class="empty-state">
    <text>暂无项目数据</text>
  </view>
</view>