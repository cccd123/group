<!-- pages/myTeam/myTeam.wxml -->
<view class="content">
  <!-- 显示加载状态 -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>
   
  <!-- 显示空状态 -->
  <view wx:elif="{{projectList.length === 0}}" class="empty">
    <text>暂无项目，快去创建一个吧！</text>
  </view>
   
  <!-- 项目列表 -->
  <block wx:for="{{projectList}}" wx:key="id" wx:for-index="index">
    <!-- 上线中的项目 -->
	<!-- !!!目前后端并没有提供 isActive 数据项，其他地方也没有做上下架的处理!!! -->
    <view wx:if="{{item.isActive}}" class="body underway">
      <view class="body-header">{{item.statusText}}</view>
	  <view class="body-frame">
      <view class="body-main" bind:tap="projectDetails" data-project-id="{{item.id}}">
        
		<!-- <text>{{item.projectName || item.brief}}</text> -->
		<!-- 第1个view -->
		<view>项目简要信息</view>
		<!-- 第2个view -->
		<view>{{item.schoolname || '泉州信息工程学院'}}</view>
         
        <view> <!-- 第3个view --> 
          <text>{{item.projectName || item.brief}}</text>
          <!-- <text>{{item.projectInfo || item.inDetail}}</text> -->
        </view>
         
        <view> <!-- 第4个view -->
          <view>
            <text>学校要求</text>
            <text>{{item.educationText}}</text>
          </view>
          <view>
            <text>项目偏向</text>
            <text>{{item.directionText}}</text>
          </view>
        </view>
         
        <view wx:if="{{item.isEmailPromotion === 1}}" class="chartWithEmailPromotion">
          <view>
            <image class="body-image1" src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/read.png"></image>
            <text>平台阅读量</text>
            <text>{{item.readCount || 0}}</text>
          </view>
          <view>
            <image class="body-image2" src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/file.png"></image>
            <text>申请投递量</text>
            <text>{{item.applicationCount || 0}}</text>
          </view>
        </view>

		<view wx:if="{{item.isEmailPromotion === 0}}" class="chartWithoutEmailPromotion">
          <view>
            <image class="body-image1" src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/read.png"></image>
            <text>平台阅读量</text>
            <text>{{item.readCount || 0}}</text>
          </view>
		  <view>
            <image class="body-image2" src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/file.png"></image>
            <text>申请投递量</text>
            <text>{{item.applicationCount || 0}}</text>
          </view>
        </view>
         
        <view wx:if="{{item.isEmailPromotion === 1}}" class="emailPromotionTips">
          <view>您已选择邮件推广，部分简历可能已发送至预留邮箱，请注意查收。</view>
        </view>
      </view><!-- end body-main -->
	  <view class="opbutton">
          <button bind:tap="performDeleteProject" data-project-id="{{item.id}}" data-index="{{index}}">删除</button>
          <button bind:tap="filtrate" data-project-id="{{item.id}}">筛选</button>
      </view>
	  </view><!-- end body-frame -->
    </view>
     
    <!-- 已下架的项目 -->
	<!-- !!!很多对 上线中的项目 部分作的修改（比如根据项目有没有进行邮件推广，显示不同内容），
			并没有对 已下架的项目 部分进行!!! -->
    <view wx:else class="body finish">
      <view class="body-header">{{item.statusText}}</view>
      <view class="body-main">
        <view>
          <text>{{item.projectName || item.brief}}</text>
          <text>学校ID: {{item.school || '泉州信息工程学院'}}</text>
        </view>
         
        <view>
          <text>{{item.projectInfo || item.inDetail}}</text>
        </view>
         
        <view>
          <view>
            <text>学历要求</text>
            <text>{{item.educationText}}</text>
          </view>
          <view>
            <text>技能要求</text>
            <text>{{item.skillSummary || item.simplenessSkill || '无特殊要求'}}</text>
          </view>
          <view>
            <text>跨校要求</text>
            <text>{{item.crossSchoolText}}</text>
          </view>
        </view>
         
        <view>
          <view>
            <image class="body-image1" src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/read.png"></image>
            <text>阅读量</text>
            <text>{{item.readCount || 0}}</text>
          </view>
          <view>
            <image class="body-image2" src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/file.png"></image>
            <text>投递量</text>
            <text>{{item.applicationCount || 0}}</text>
          </view>
        </view>
         
        <view wx:if="{{item.isEmailPromotion === 1}}">
          <view>您已选择邮件推广，部分简历可能已发送至预留邮箱，请注意查收。</view>
        </view>
         
        <view>
          <button bind:tap="reactivateProject" data-project-id="{{item.id}}" data-index="{{index}}">重新上架</button>
          <button bind:tap="filtrate" data-project-id="{{item.id}}">筛选</button>
        </view>
      </view>
    </view>
  </block>
</view>