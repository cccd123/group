<view class="container">
  <!-- 标签页头部 -->
  <view class="tab-header">
    <view class="tab-item {{state === '1' ? 'active' : ''}}" data-state="1" bindtap="state">
      <text class="tab-icon">📋</text>
      <text>待审核</text>
    </view>
    <view class="tab-item {{state === '2' ? 'active' : ''}}" data-state="2" bindtap="state">
      <text class="tab-icon">✅</text>
      <text>已通过</text>
    </view>
    <view class="tab-item {{state === '3' ? 'active' : ''}}" data-state="3" bindtap="state">
      <text class="tab-icon">❌</text>
      <text>已拒绝</text>
    </view>
    <view class="tab-indicator" style="left: {{stateIndicatorPos}}%;"></view>
  </view>

  <!-- 内容区域 -->
  <view class="content">
    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="loading">
      <view class="spinner"></view>
      <text>加载中...</text>
    </view>

    <!-- 待审核页面 -->
    <view wx:if="{{state === '1' && !loading}}">
      <view class="stats-card">
        <view class="stats-number">{{applicantList.length}}</view>
        <view class="stats-label">待审核申请</view>
      </view>

	  <scroll-view class="applicant-list" scroll-y="true">
	  <view wx:if="{{applicantList.length === 0}}" class="empty-state">
        <view class="empty-icon">📋</view>
        <view class="empty-text">暂无待审核申请</view>
        <view class="empty-subtext">新的申请会在这里显示</view>
      </view>

      <view wx:for="{{applicantList}}" wx:key="id" class="applicant-card">
        <view class="applicant-header">
		  <image wx:if="{{!item.avatarUrl}}" src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/头像.jpg" class="avatar"></image>
		  <image wx:else src="{{'https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu_text_img/' + item.avatarUrl}}" class="avatar"></image>
          <view class="applicant-info">
            <view class="applicant-name">{{item.nickname}}</view>
            <view class="applicant-school">{{item.schoolname}}</view>
          </view>
          <view class="status-badge status-pending">待审核</view>
        </view>
        <view class="action-buttons">
          <button class="btn btn-view" bindtap="viewApplicantDetail" data-pass="false" data-id="{{item.id}}" data-applicant="{{item}}">查看详情</button>
          <button class="btn btn-approve" bindtap="handleApproval" data-user-openid="{{item.openid}}" data-action="approve">通过</button>
          <button class="btn btn-reject" bindtap="handleApproval" data-user-openid="{{item.openid}}" data-action="reject">拒绝</button>
        </view>
      </view>
	  </scroll-view>
      
    </view>

    <!-- 已通过页面 -->
    <view wx:if="{{state === '2' && !loading}}">
      <view class="tip-card">
        🎉 筛选通过的同学平台已开放互相双方预留的联系方式，您可点击下方个人主页查看人才预留联系方式
      </view>

      <view class="stats-card">
        <view class="stats-number">{{applicantList.length}}</view>
        <view class="stats-label">已通过申请</view>
      </view>

	  <scroll-view class="applicant-list" scroll-y="true">
      <view wx:if="{{applicantList.length === 0}}" class="empty-state">
        <view class="empty-icon">✅</view>
        <view class="empty-text">暂无通过的申请</view>
        <view class="empty-subtext">审核通过的申请会在这里显示</view>
      </view>

      <view wx:for="{{applicantList}}" wx:key="id" class="applicant-card">
        <view class="applicant-header">
		  <image wx:if="{{!item.avatarUrl}}" src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/头像.jpg" class="avatar"></image>
		  <image wx:else src="{{'https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu_text_img/' + item.avatarUrl}}" class="avatar"></image>
          <view class="applicant-info">
            <view class="applicant-name">{{item.nickname}}</view>
            <view class="applicant-school">{{item.schoolname}}</view>
          </view>
          <view class="status-badge status-approved">已通过</view>
        </view>
        <view class="action-buttons">
          <button class="btn btn-view" bindtap="viewApplicantDetail" data-pass="true" data-id="{{item.id}}" data-applicant="{{item}}">查看详情</button>
          <text class="approved-text">已通过审核</text>
        </view>
      </view>
	  </scroll-view>
    </view>

    <!-- 已拒绝页面 -->
    <view wx:if="{{state === '3' && !loading}}">
      <view class="stats-card">
        <view class="stats-number">{{applicantList.length}}</view>
        <view class="stats-label">已拒绝申请</view>
      </view>

	  <scroll-view class="applicant-list" scroll-y="true">
      <view wx:if="{{applicantList.length === 0}}" class="empty-state">
        <view class="empty-icon">❌</view>
        <view class="empty-text">暂无被拒绝的申请</view>
        <view class="empty-subtext">被拒绝的申请会在这里显示</view>
      </view>

      <view wx:for="{{applicantList}}" wx:key="id" class="applicant-card">
        <view class="applicant-header">
		  <image wx:if="{{!item.avatarUrl}}" src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/头像.jpg" class="avatar"></image>
		  <image wx:else src="{{'https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu_text_img/' + item.avatarUrl}}" class="avatar"></image>
          <view class="applicant-info">
            <view class="applicant-name">{{item.nickname}}</view>
            <view class="applicant-school">{{item.schoolname}}</view>
          </view>
          <view class="status-badge status-rejected">已拒绝</view>
        </view>
        <view class="action-buttons">
          <button class="btn btn-view" bindtap="viewApplicantDetail" data-pass="false" data-id="{{item.id}}" data-applicant="{{item}}">查看详情</button>
          <text class="rejected-text">已拒绝申请</text>
        </view>
      </view>
	  </scroll-view>
    </view>
  </view>
</view>