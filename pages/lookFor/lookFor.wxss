/* lookFor.wxss */

/* 页面容器 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 顶部标签栏 */
.tab-header {
  display: flex;
  background: #ffffff;
  margin: 0;
  padding: 20rpx 40rpx;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #e5e5e5;
}

.tab-item {
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #666666;
  background-color: #f0f0f0;
  transition: all 0.3s ease;
  font-weight: 500;
}

.tab-item.active {
  background-color: #333333;
  color: #ffffff;
}

/* 内容区域 */
.tab-content {
  padding: 30rpx 40rpx 0;
}

/* 项目卡片 */
.project-card {
  background: #ffffff;
  margin-bottom: 30rpx;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.05);
  position: relative;
  cursor: pointer;
  transition: all 0.2s ease;
}

.project-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 项目标题 */
.project-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #000000;
  margin-bottom: 20rpx;
  line-height: 1.3;
}

/* 学校名称 - 右上角 */
/* 右上角学校信息 */
.school-info  {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  font-size: 24rpx;
  color: #999999;
  font-weight: 400;
}

/* 项目简要信息 */
.project-brief {
  margin-bottom: 40rpx;
  margin-top: 10rpx;
}

.brief-label {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 12rpx;
  font-weight: 700;
}

.brief-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  max-height: 96rpx;
}

/* 底部信息区域 */
.project-info-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 0;
}

.info-item {
  flex: 1;
  text-align: center;
}

.info-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 600;
  line-height: 1.4;
}

/* 隐藏原有的信息显示方式 */
.project-skill,
.project-skill-detail,
.project-time,
.project-desc {
  display: none;
}

/* 隐藏详情按钮 */
.detail-btn {
  display: none;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999999;
  font-size: 28rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-top: 40rpx;
}

.empty-tip::before {
  content: '📝';
  display: block;
  font-size: 60rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

/* 加载状态 */
.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #999999;
  font-size: 26rpx;
}

/* 响应式调整 */
@media screen and (max-width: 750rpx) {
  .project-card {
    margin: 0 20rpx 30rpx;
    padding: 30rpx;
  }
  
  .tab-content {
    padding: 30rpx 0 0;
  }
  
  .project-school {
    position: static;
    text-align: right;
    margin-bottom: 10rpx;
    margin-top: -10rpx;
  }
}