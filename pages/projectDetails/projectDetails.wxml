<view class="content">
	<view>
		<view class="content-body">
			<text>项目简要信息</text>
			<text>{{projectDetails.projectDescription || '暂无项目描述'}}</text>
		</view>
		<view class="content-body">
			<text>项目详情</text>
			<text>{{projectDetails.projectDetail || '暂无详细信息'}}</text>
		</view>

		<view class="content-main">
			<view>
				<text>队伍预计规模</text>
				<text>{{projectDetails.teamSize || '未知'}}人</text>
			</view>
			<view>
				<text>是否接受跨校</text>
				<text>{{projectDetails.crossSchool || '未知'}}</text>
			</view>
		</view>

		<view class="content-school">
			<text>项目发起校</text>
			<text>{{projectDetails.school || '未知学校'}}</text>
		</view>

		<view class="content-main">
			<view>
				<text>学校要求</text>
				<text>{{projectDetails.requirement || '未知'}}</text>
			</view>
			<view>
				<text>项目偏向</text>
				<view>
					<view class="header-title">
					<view class="header-title-name {{ direction === '落地' ? 'active' : '' }}" data-direction="落地" bindtap="direction">落地</view>
					<view class="header-title-name {{ direction === '获奖' ? 'active' : '' }}" data-direction="获奖" bindtap="direction">获奖</view>
					<view class="header-title-name {{ direction === '学习' ? 'active' : '' }}" data-direction="学习" bindtap="direction">学习</view>
					</view>
				</view>
			</view>
		</view>

		<view class="content-body">
			<view class="requirement">
				<text>详细要求</text>
				<text>{{projectDetails.detailRequirement || '暂无详细要求'}}</text>
			</view>
			<view class="other">
				<radio-group>
				<label>
					<radio class="bg" checked="{{projectDetails.flexible || false}}">学习能力强，积极热情亦可参与</radio>
				</label>
				</radio-group>
			</view>
		</view>
	</view>

  <view>
    <view>
      <image src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/上传.png"></image>
      <text>下一条</text>
    </view>
    <!-- 为投递信息按钮添加点击事件 -->
    <view bindtap="joinProject">
      <image src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/喜欢.png"></image>
      <text>投递信息</text>
    </view>
</view>
</view>