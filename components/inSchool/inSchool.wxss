/* inSchool */
.maskSchool {
  z-index: 998;
  background: rgba(39, 38, 38, 0.5);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.inSchool {
  z-index: 999;
  background-color: rgb(255, 254, 254);
  position: fixed;
  top: 10%;
  left: 10%;
  right: 10%;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  padding: 20rpx 20rpx;
  bottom: 10%;
}

.inSchool .school-input {
  margin-top: 10rpx;
  border: 1rpx solid #000;
  border-radius: 10rpx;
  padding-left: 10rpx;
}

.school-list {
  flex: 1;
  overflow: hidden;
}

.school-list .school-item {
  margin-top:10rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}